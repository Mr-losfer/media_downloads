#!/bin/bash
# Media Super 生命周期脚本：start / stop / status
set -u

APP_DIR="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
DATA_DIR="${VAR_DIR}/data"
LOG_FILE="${VAR_DIR}/mediasuper.log"
PID_FILE="${VAR_DIR}/mediasuper.pid"
PORT="${TRIM_SERVICE_PORT:-9099}"
BIN="${APP_DIR}/server/mediasuper"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

is_running() {
  [ -r "${PID_FILE}" ] || return 1
  local pid
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
  [ -n "${pid}" ] || return 1
  kill -0 "${pid}" 2>/dev/null
}

start_app() {
  if is_running; then
    return 0
  fi

  if [ ! -x "${BIN}" ]; then
    echo "找不到可执行文件 ${BIN}，请重新安装应用。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
  fi

  mkdir -p "${DATA_DIR}" || exit 1

  # 下载目录：优先用共享目录（用户在文件管理里能看到），没有就退回应用数据目录
  local share="${TRIM_DATA_SHARE_PATHS%%:*}"
  if [ -z "${share}" ] || [ ! -d "${share}" ]; then
    share="${VAR_DIR}/downloads"
    mkdir -p "${share}"
  fi

  export MS_ADDR=":${PORT}"
  export MS_DATA_DIR="${DATA_DIR}"
  export MS_FFMPEG="${MS_FFMPEG:-ffmpeg}"
  export MS_SAVE_DIRS="${MS_SAVE_DIRS:-${share}:下载}"
  export MS_DEFAULT_DIR="${MS_DEFAULT_DIR:-${share}}"
  # 首次安装用默认密码 losfer，之后密码存在数据库里，这里的变量就不再起作用
  if [ -z "${MS_ADMIN_PASS:-}" ] && [ ! -f "${DATA_DIR}/mediasuper.db" ]; then
    export MS_ADMIN_PASS=losfer
  fi

  log_msg "启动 Media Super ${TRIM_APPVER}，端口 ${PORT}，数据目录 ${DATA_DIR}"
  nohup "${BIN}" >> "${LOG_FILE}" 2>&1 &
  echo $! > "${PID_FILE}"

  local i=0
  while [ "${i}" -lt 15 ]; do
    if is_running; then
      log_msg "启动成功，PID $(cat "${PID_FILE}")"
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done

  echo "Media Super 启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  exit 1
}

stop_app() {
  if ! is_running; then
    rm -f "${PID_FILE}"
    return 0
  fi
  local pid
  pid="$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')"
  log_msg "停止进程 ${pid}"
  kill -TERM "${pid}" 2>/dev/null

  local i=0
  while kill -0 "${pid}" 2>/dev/null && [ "${i}" -lt 12 ]; do
    sleep 1
    i=$((i + 1))
  done
  if kill -0 "${pid}" 2>/dev/null; then
    log_msg "进程未退出，强制结束"
    kill -KILL "${pid}" 2>/dev/null
  fi
  rm -f "${PID_FILE}"
  return 0
}

case "$1" in
  start)   start_app ;;
  stop)    stop_app ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  restart)
    stop_app
    start_app
    ;;
  *)
    echo "unknown command: $1" >&2
    exit 1
    ;;
esac
