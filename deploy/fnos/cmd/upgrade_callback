#!/bin/bash
# 升级完成：保留原有端口与密码，只补齐配置后重启
set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

# $0 自定位优先，TRIM_APPDEST 指向 target 时拼 cmd/ 会找不到脚本
find_main() {
  local c self
  self="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/main"
  for c in "$self" "${TRIM_APPDEST:-}/cmd/main" \
    "$(dirname "${TRIM_APPDEST:-/}")/cmd/main" /var/apps/mediasuper/cmd/main; do
    [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

MAIN="$(find_main || true)"
[ -n "$MAIN" ] || exit 0

# 升级向导里如果填了端口就用新的，否则沿用旧配置
if [ -n "${wizard_port:-}" ]; then
  bash "$MAIN" setport "${wizard_port}" || true
else
  bash "$MAIN" setport "$(bash "$MAIN" resolve-port)" || true
fi

bash "$MAIN" start || true
exit 0
